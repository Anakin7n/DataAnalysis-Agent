# 飞书应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LLM 参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT=15

# Session 超时 (秒)
SESSION_TIMEOUT=600

# 日志级别
LOG_LEVEL=INFO

# 外部 Bot 路径（可选，默认自动识别本项目的同级目录）
# REELCLEAN_DIR=D:\ReelClean-bot
# PREDICTION_DIR=D:\Prediction-Bot
# FEISHU_BOT_DIR=D:\feishu-bot
